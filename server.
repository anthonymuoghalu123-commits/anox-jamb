      to {
        transform: rotate(360deg);
      }
    }

    @keyframes hideSplash {
  0%, 70% {
    opacity: 1;
    visibility: visible;
  }
  100% {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }
}

    .header {
      background: #0b5cff;
      color: white;
      padding: 28px 20px;
      border-radius: 0 0 25px 25px;
    }

    .header h1 {
      margin: 0 0 8px;
      font-size: 28px;
    }

    .header p {
      margin: 0;
      opacity: 0.9;
    }

    .container {
      padding: 22px 18px;
    }

    .card {
      background: white;
      padding: 20px;
      border-radius: 18px;
      margin-bottom: 18px;
      box-shadow: 0 5px 20px rgba(0, 0, 0, 0.06);
    }

    .card h2 {
      margin-top: 0;
    }

    .start-btn {
      width: 100%;
      border: none;
      padding: 16px;
      border-radius: 14px;
      background: #0b5cff;
